# ---------------------------------------------------------------------------
# Local development environment.
#
# Copy this file to `.env` and adjust. `.env` is gitignored — never commit real
# credentials. Every value here is a NON-SECRET local development default.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=revenue_intelligence
POSTGRES_USER=revenue
POSTGRES_PASSWORD=revenue_local_dev
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Kafka ------------------------------------------------------------------
# KRaft single-node broker. No ZooKeeper, no SASL/TLS in local development.
KAFKA_PORT=9092

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8080
# Address the backend listens on. Used to build the JDBC URL and as the Vite
# dev-server proxy target. Change this only if the database is not local.
DB_HOST=localhost

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=5173
# Read by vite.config.ts to proxy /api and /actuator during development.
BACKEND_URL=http://localhost:8080
# Normally left unset: the frontend then calls same-origin /api paths, which
# Vite proxies. Set it only when the API is on a different origin, which also
# makes CORS configuration relevant.
# VITE_API_BASE_URL=https://api.example.com/api
